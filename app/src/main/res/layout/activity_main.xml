<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="10dp" android:paddingTop="12dp">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gallery" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold"/>
        <ImageButton android:id="@+id/btnSearch" style="@style/IconBtn" android:src="@drawable/ic_search"/>
        <ImageButton android:id="@+id/btnSort" style="@style/IconBtn" android:src="@drawable/ic_sort"/>
        <ImageButton android:id="@+id/btnGrid" style="@style/IconBtn" android:src="@drawable/ic_grid"/>
    </LinearLayout>
    <EditText android:id="@+id/search" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:visibility="gone" android:hint="Search by name" android:singleLine="true" android:background="@drawable/bg_chip" android:padding="14dp" android:textColor="@color/text" android:textColorHint="@color/sub"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="16dp" android:background="@drawable/bg_chip" android:padding="4dp">
        <TextView android:id="@+id/tab0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="Photos" android:textStyle="bold"/>
        <TextView android:id="@+id/tab1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="Albums" android:textStyle="bold"/>
        <TextView android:id="@+id/tab2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="Favorites" android:textStyle="bold"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:clipToPadding="false"/>
        <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="32dp" android:textColor="@color/sub" android:textSize="16sp" android:visibility="gone"/>
    </FrameLayout>
    <LinearLayout android:id="@+id/selBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:background="@drawable/bg_card" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:visibility="gone">
        <TextView android:id="@+id/selCount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text" android:textStyle="bold"/>
        <ImageButton android:id="@+id/selFav" style="@style/IconBtn" android:src="@drawable/ic_heart"/>
        <ImageButton android:id="@+id/selShare" style="@style/IconBtn" android:src="@drawable/ic_share"/>
        <ImageButton android:id="@+id/selDel" style="@style/IconBtn" android:src="@drawable/ic_delete"/>
        <ImageButton android:id="@+id/selClose" style="@style/IconBtn" android:src="@drawable/ic_close"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="8dp">
        <ImageButton android:id="@+id/eClose" style="@style/IconBtn" android:src="@drawable/ic_close"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:text="Edit photo" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/eUndo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="Undo" android:textColor="@color/sub" android:textStyle="bold"/>
        <TextView android:id="@+id/eReset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:text="Reset" android:textColor="@color/sub" android:textStyle="bold"/>
        <TextView android:id="@+id/eSave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:background="@drawable/bg_chip" android:backgroundTint="@color/accent" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="9dp" android:paddingBottom="9dp" android:text="Save" android:textColor="#FFF" android:textStyle="bold"/>
    </LinearLayout>
    <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:scaleType="fitCenter"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="12dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="14dp">
        <LinearLayout android:id="@+id/tools" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="130dp" android:orientation="vertical" android:gravity="center_vertical"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
            <TextView android:id="@+id/eTab0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="Adjust" android:textStyle="bold"/>
            <TextView android:id="@+id/eTab1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="Filters" android:textStyle="bold"/>
            <TextView android:id="@+id/eTab2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:padding="10dp" android:text="Transform" android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
